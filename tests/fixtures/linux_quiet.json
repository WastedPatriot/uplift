{
  "label": "quiet-linux",
  "os": "linux",
  "notes": "A dull host. Baseline setuid only, modern kernel, nothing writable.",
  "user": {"name": "student", "uid": 1000, "gids": [1000], "groups": ["student"]},
  "env": {
    "PATH": "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin",
    "HOME": "/home/student"
  },
  "kernel": "6.8.0-31-generic",
  "files": {
    "/bin": {"type": "dir", "mode": "0755", "uid": 0, "gid": 0},
    "/sbin": {"type": "dir", "mode": "0755", "uid": 0, "gid": 0},
    "/usr/bin": {"type": "dir", "mode": "0755", "uid": 0, "gid": 0},
    "/usr/sbin": {"type": "dir", "mode": "0755", "uid": 0, "gid": 0},
    "/usr/local/bin": {"type": "dir", "mode": "0755", "uid": 0, "gid": 0},
    "/usr/local/sbin": {"type": "dir", "mode": "0755", "uid": 0, "gid": 0},
    "/usr/bin/sudo": {"type": "file", "mode": "4755", "uid": 0, "gid": 0},
    "/usr/bin/passwd": {"type": "file", "mode": "4755", "uid": 0, "gid": 0},
    "/etc": {"type": "dir", "mode": "0755", "uid": 0, "gid": 0},
    "/etc/passwd": {
      "type": "file",
      "mode": "0644",
      "uid": 0,
      "gid": 0,
      "content": "root:x:0:0:root:/root:/bin/bash\nstudent:x:1000:1000::/home/student:/bin/bash\n"
    },
    "/etc/shadow": {"type": "file", "mode": "0640", "uid": 0, "gid": 42}
  }
}
